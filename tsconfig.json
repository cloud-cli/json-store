{
  "compilerOptions": {
    "moduleResolution": "nodenext",
    "module": "nodenext",
    "target": "esnext",
    "lib": ["ESNext", "DOM"],
    "esModuleInterop": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitAny": false,
    "allowJs": true,
    "rootDir": "src",
    "outDir": "./build/",
    "declaration": true,
    "experimentalDecorators": true,
    "strictPropertyInitialization": false
  },
  "include": ["src/app/**/*.ts"],
  "exclude": ["src/**"],
  "files": ["src/index.ts"]
}
