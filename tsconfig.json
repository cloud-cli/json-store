{
  "compilerOptions": {
    "moduleResolution": "nodenext",
    "module": "nodenext",
    "target": "esnext",
    "lib": ["ESNext", "DOM"],
    "esModuleInterop": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitAny": false,
    "allowJs": true,
    "rootDir": "./app",
    "outDir": "./build/",
    "declaration": true,
    "experimentalDecorators": true
  },
  "include": ["src/app/**/*.ts"],
  "exclude": ["app/**"],
  "files": ["app/index.ts"]
}
